{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vosh",
  "version": "0.0.1",
  "identifier": "com.aabahran.vosh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vosh",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "fullscreen": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "A desktop MUD client called Vosh.",
    "longDescription": "Vosh is a desktop MUD client for macOS, Windows, and Linux. Telnet, GMCP, ANSI rendering, triggers, aliases, scripting, and a connected map window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/REPLACE_OWNER/REPLACE_REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_BASE64_MINISIGN_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
