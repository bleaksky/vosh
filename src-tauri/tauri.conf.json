{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mudclient",
  "version": "0.0.1",
  "identifier": "com.aabahran.mudclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mudclient",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A desktop MUD client.",
    "longDescription": "A desktop MUD client for macOS, Windows, and Linux. Telnet, GMCP, ANSI rendering, triggers, aliases, scripting, and a connected map window."
  }
}
