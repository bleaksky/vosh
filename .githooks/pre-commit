#!/usr/bin/env bash
# Pre-commit hook for mudclient.
# Enable once with: git config core.hooksPath .githooks

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Collect staged files by type.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
# Prettier formats every web file. ESLint only lints scripts, so markdown,
# JSON, CSS and HTML never reach it and it prints no ignored file warnings.
staged_web=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|jsx|json|css|html|md)$' || true)
staged_scripts=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)
staged_rs=$(printf '%s\n' "$staged" | grep -E '\.rs$' || true)

if [ -n "$staged_web" ]; then
  echo "==> prettier --check"
  npx --no-install prettier --check $staged_web
fi

if [ -n "$staged_scripts" ]; then
  echo "==> eslint"
  npx --no-install eslint $staged_scripts
fi

if [ -n "$staged_rs" ]; then
  echo "==> cargo fmt --check"
  cargo fmt --all -- --check
  echo "==> cargo clippy"
  cargo clippy --workspace --all-targets --all-features -- -D warnings
fi

echo "pre-commit checks passed"
